# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# Compose reads this file to configure the two services explicitly.
#
# `just bootstrap` generates the three secrets below. See docs/development.md.

# --- Auth (required) --------------------------------------------------------
# Generate each independently, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Static bearer token used only by Android Health Connect at the host origin.
TETHER_API_TOKEN=change-me
# Server-side bearer token interpolated into Open WebUI's environment-owned
# Tether tool connection. Never enter it in browser chat or reuse the Capture
# token.
TETHER_OPEN_WEBUI_TOKEN=change-me
# Open WebUI signs its own sessions with this independent secret.
WEBUI_SECRET_KEY=change-me

# --- Origins ----------------------------------------------------------------
# Canonical Open WebUI origin. Production uses the Tailscale host on HTTPS 8443.
WEBUI_URL=http://127.0.0.1:3000

# --- Model provider (required) -----------------------------------------------
# One or more semicolon-separated OpenAI-compatible endpoints and matching keys.
OPENAI_API_BASE_URLS=https://api.openai.com/v1
OPENAI_API_KEYS=change-me

# --- Voice (optional until the physical-phone acceptance gate) ---------------
# Global Admin UI changes are runtime-only, so configure the chosen OpenAI-
# compatible speech provider here before testing voice.
# AUDIO_STT_ENGINE=openai
# AUDIO_STT_MODEL=whisper-1
# AUDIO_STT_OPENAI_API_BASE_URL=https://api.openai.com/v1
# AUDIO_STT_OPENAI_API_KEY=change-me
# AUDIO_TTS_ENGINE=openai
# AUDIO_TTS_MODEL=tts-1
# AUDIO_TTS_OPENAI_API_BASE_URL=https://api.openai.com/v1
# AUDIO_TTS_OPENAI_API_KEY=change-me
# AUDIO_TTS_VOICE=alloy
