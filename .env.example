# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
# compose loads this file into the host container.
#
# For local dev, `just bootstrap` writes this file with TETHER_APP_PASSWORD and
# TETHER_SESSION_SECRET already generated. See docs/development.md.

# --- Auth (required) --------------------------------------------------------
# App login password, session-cookie signing secret, and static bearer token for
# phone/watch capture clients. Generate each independently, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TETHER_APP_PASSWORD=change-me
TETHER_SESSION_SECRET=change-me
TETHER_API_TOKEN=change-me

# --- Speech-to-text (required) -----------------------------------------------
# STT is an always-on host dependency (ADR 0018): the host fails fast at boot
# if this is unset. Points at any OpenAI-compatible transcription endpoint
# (OpenAI, Groq, a self-hosted server) by base URL.
TETHER_STT_API_KEY=change-me
# TETHER_STT_BASE_URL=https://api.openai.com/v1
# TETHER_STT_MODEL=whisper-1

# --- Text-to-speech (required) -----------------------------------------------
# Conversation mode generates consistent audio through an OpenAI-compatible
# speech endpoint. This is independent from STT because deployments may use
# different providers for transcription and speech generation.
TETHER_TTS_API_KEY=change-me
# TETHER_TTS_BASE_URL=https://api.openai.com/v1
# TETHER_TTS_MODEL=gpt-4o-mini-tts
# TETHER_TTS_VOICE=alloy

# --- Cookies ----------------------------------------------------------------
# Secure cookies require HTTPS. Leave false for local http compose; set true on
# the VM, where Tailscale Funnel exposes the app over HTTPS.
TETHER_SECURE_COOKIES=false
# Canonical browser origin for OAuth callbacks behind an HTTPS-terminating proxy.
# Leave empty for direct local HTTP; set to the Funnel origin in production.
# TETHER_PUBLIC_ORIGIN=https://tether.example.ts.net

# --- Web Push (optional) -----------------------------------------------------
# Enables closed-tab browser notifications for fired Scheduled triggers.
# Generate with:
#   uv run python -m py_vapid --gen
#   uv run python -m py_vapid --applicationServerKey --private-key private_key.pem
# TETHER_VAPID_PUBLIC_KEY=application-server-key-from-command-above
# TETHER_VAPID_PRIVATE_KEY=contents-of-private_key.pem
# TETHER_VAPID_SUBJECT=mailto:you@example.com

# --- Agent model (required for chat / scheduled-prompt triggers) ------------
# The default model id and the allowlist the UI offers. The allowlist is JSON;
# `id` is selected by `TETHER_DEFAULT_MODEL`. Provider credentials do not live
# in this file; pi reads them from ${TETHER_PI_AGENT_DIR}/auth.json.
# The allowlist MUST stay single-quoted: `just` loads this file via dotenv, and
# its parser strips embedded double quotes from an unquoted value, which would
# corrupt the JSON and crash the host at startup.
TETHER_DEFAULT_MODEL=gpt-5.6-luna
TETHER_MODEL_ALLOWLIST='[{"display_name":"GPT-5.6 Luna · no thinking","id":"gpt-5.6-luna","model_id":"gpt-5.6-luna","provider":"openai-codex","thinking_level":"off"},{"display_name":"GPT-5.6 Luna · low thinking","id":"gpt-5.6-luna-low","model_id":"gpt-5.6-luna","provider":"openai-codex","thinking_level":"low"},{"display_name":"GPT-5.6 Terra · low thinking","id":"gpt-5.6-terra-low","model_id":"gpt-5.6-terra","provider":"openai-codex","thinking_level":"low"},{"display_name":"GPT-5.6 Terra · medium thinking","id":"gpt-5.6-terra","model_id":"gpt-5.6-terra","provider":"openai-codex","thinking_level":"medium"},{"display_name":"GPT-5.6 Sol · medium thinking","id":"gpt-5.6-sol","model_id":"gpt-5.6-sol","provider":"openai-codex","thinking_level":"medium"}]'

# --- pi provider credentials -------------------------------------------------
# Mounted into the container as /pi-agent and used as PI_CODING_AGENT_DIR. This
# directory is durable secret state: it holds auth.json (Codex OAuth tokens,
# OpenCode Go API key, etc.) and optional pi models/settings files. Keep it
# outside the repo; back it up on the deployment server.
#
# Local bootstrap:
#   mkdir -p ~/.local/share/tether/pi-agent
#   chmod 700 ~/.local/share/tether/pi-agent
#   Start Tether, then use Settings -> Model provider -> Connect ChatGPT.
#   For providers not supported by web recovery, use `just pi-auth` and /login.
#
# Server example:
#   TETHER_PI_AGENT_DIR=/srv/tether/pi-agent
#   Authorize from Tether Settings; never copy a workstation's rotating auth.json.
#   Back up /srv/tether/pi-agent/auth.json as server-owned secret state.
#
# Current image runs as root, so refreshed OAuth files may become root-owned.
TETHER_PI_AGENT_DIR=${HOME}/.local/share/tether/pi-agent

# --- YouTube ingestion (optional) -------------------------------------------
# Tether pulls liked videos through browser-managed Google OAuth. Create a Web
# application OAuth client, register this callback exactly, and install its JSON
# at TETHER_YOUTUBE_CLIENT_SECRET_PATH:
#   https://<your-tether-origin>/api/youtube-auth/callback
# Then open Settings → YouTube → Connect YouTube. Tether stores the resulting
# token at TETHER_YOUTUBE_TOKEN_PATH and starts syncing immediately. Publish the
# Google consent app to Production; Testing-mode refresh tokens can expire after
# seven days.
#
# These paths are defaults for a native run. Compose overrides them to durable
# /data/youtube paths; see docs/deployment.md#youtube-ingestion.
# TETHER_YOUTUBE_CLIENT_SECRET_PATH=.tether/youtube-client-secret.json
# TETHER_YOUTUBE_TOKEN_PATH=.tether/youtube-oauth-token.json
# TETHER_YOUTUBE_OAUTH_NO_BROWSER=false
#
# Background workers (both default on once a token exists). Set to false to keep
# the client wired for on-demand use while skipping the eager boot sync/drain
# (e.g. the fast dev loop, where the startup pass delays the port binding).
# TETHER_YOUTUBE_SYNC_ENABLED=true
# TETHER_TRANSCRIPT_SYNC_ENABLED=true
#
# Likes backfill: history is walked once, then only the newest ("hot") pages
# refresh until the completed walk ages past the re-walk interval (days) or the
# corpus drifts more than the margin below the upstream total. Videos with no
# fetchable details (deleted, private, members-only) are tracked by id and folded
# into the drift comparison precisely, so the margin only absorbs transient races.
# `just youtube-reset-backfill` forces a full re-walk on demand.
# TETHER_YOUTUBE_LIKES_REWALK_INTERVAL_DAYS=30
# TETHER_YOUTUBE_LIKES_DRIFT_ALARM_MARGIN=5
#
# --- Transcripts ------------------------------------------------------------
# The transcript chain is composed from a comma-separated source order, primary
# first. Known sources: `supadata` (paid, the reliable primary for third-party
# liked videos), `library` (the free youtube-transcript-api), `captions` (the
# owner-only Data API, dropped from the default because it transcribes almost
# nothing). An unknown name is rejected at startup; an unconfigured one is skipped.
# TETHER_TRANSCRIPT_PROVIDER_ORDER=supadata,library
# Preferred transcript languages, most preferred first (ISO codes).
# TETHER_TRANSCRIPT_LANGUAGES=en,ro
# Drop the free library from the chain entirely (e.g. if the host IP is blocked).
# TETHER_TRANSCRIPT_LIBRARY_ENABLED=true
# The free library gets the host IP-blocked in bursts of ~10+ rapid requests, so
# these are deliberately strict: a hard cap on real library calls per sync pass,
# plus mandatory spacing between them.
# TETHER_TRANSCRIPT_LIBRARY_MAX_REQUESTS_PER_PASS=5
# TETHER_TRANSCRIPT_LIBRARY_MIN_REQUEST_INTERVAL_SECONDS=5.0
# Escalating cooldown once a blockable source (library or Supadata) reports an
# IP block/rate limit: starts at the base, doubles on each further consecutive
# block, clamped at the cap.
# TETHER_TRANSCRIPT_BLOCK_PAUSE_BASE_SECONDS=7200
# TETHER_TRANSCRIPT_BLOCK_PAUSE_CAP_SECONDS=86400
#
# Supadata (paid, off by default). Enabling it AND setting a key makes it the
# primary source. `native` mode fetches an existing caption track (one use per
# call); the use cap is a hard MONTHLY budget (resets at the UTC month boundary),
# persisted across restarts, so a bounded plan is never overspent.
# TETHER_SUPADATA_ENABLED=false
# TETHER_SUPADATA_API_KEY=
# TETHER_SUPADATA_MAX_USES=3000
# TETHER_SUPADATA_MODE=native
# TETHER_SUPADATA_BASE_URL=https://api.supadata.ai/v1
# Minimum seconds between billed Supadata submits. The sweep fetches videos
# back-to-back, so a low-rate plan 429s on the burst and pauses the source;
# spacing keeps requests under that per-request rate. Default 1.0; set 0 to
# disable pacing on a generous plan.
# TETHER_SUPADATA_MIN_REQUEST_INTERVAL_SECONDS=1.0

# --- Web search (optional) ---------------------------------------------------
# Agent web search uses Tavily and defaults on, but an API key is still required;
# without one no provider is wired. Basic searches cost one credit; advanced
# searches cost two. The hard UTC-calendar-month cap persists across restarts.
# TETHER_SEARCH_ENABLED=true
# TETHER_SEARCH_API_KEY=
# TETHER_SEARCH_MAX_USES=1000
# Minimum seconds between Tavily requests. Default 1.0; set 0 to disable pacing.
# TETHER_SEARCH_MIN_REQUEST_INTERVAL_SECONDS=1.0

# --- Gmail tooling + ingestion (optional) ----------------------------------
# With a token present, two things can happen:
# 1) Agent-facing read tools (`search_gmail`, `read_gmail_message`) use
#    gmail.readonly to search and fetch raw RFC 2822 text.
# 2) The background ingest/pipeline (`gmail_sync_enabled`) triages incoming mail
#    and can propose labels/archival actions when a model detects a strong signal.
#
# The read tools are always safe and non-mutating; they do not need sync enabled.
# To enable background ingestion too, run `just gmail-auth` and set
# `TETHER_GMAIL_SYNC_ENABLED=true`.
#
# Install Google clients (shared with YouTube): `uv sync --group youtube`
# Then either reuse the YouTube client-secret JSON (as long as it permits
# gmail.readonly), or set TETHER_GMAIL_CLIENT_SECRET_PATH to another Desktop-
# app client. After `just gmail-auth`, the token lands at
# TETHER_GMAIL_TOKEN_PATH (or is refreshed there).
#
# TETHER_GMAIL_CLIENT_SECRET_PATH=.tether/youtube-client-secret.json
# TETHER_GMAIL_TOKEN_PATH=.tether/gmail-oauth-token.json
# TETHER_GMAIL_OAUTH_NO_BROWSER=false
# TETHER_GMAIL_SYNC_ENABLED=false
# TETHER_GMAIL_SYNC_INTERVAL_SECONDS=900
# TETHER_GMAIL_TRIAGE_BATCH_SIZE=10
#
# --- Gmail backlog purge (optional, write side) ------------------------------
# A sweep that PROPOSES inbox hygiene (archive/label/move-to-trash) for backlog
# mail; it never writes the mailbox directly — the host executes an approved
# proposal through the gmail.* action executors, gated by human approval or a
# standing autonomy grant. Needs the gmail.modify OAuth scope: `just gmail-auth`
# requests it now, but a token minted before this scope existed must be
# re-authorized — delete .tether/gmail-oauth-token.json and re-run gmail-auth,
# re-consenting to the modify permission (see docs/development.md). Off by
# default; a no-op unless the Gmail transport is also configured.
# TETHER_GMAIL_PURGE_ENABLED=false
# TETHER_GMAIL_PURGE_INTERVAL_SECONDS=3600
# TETHER_GMAIL_PURGE_CHUNK_SIZE=10
