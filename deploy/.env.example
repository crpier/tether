# Production `.env` template for the VM deploy (docs/deployment.md).
#
# Copy to `/srv/tether/.env` (next to `compose.yaml`) and fill in real values —
# assembled by hand from 1Password (source of truth), never committed.
# `deploy/restic.env.example` is separate: it's read by the backup timer, not by
# the app container.
#
# This mirrors the repo-root `.env.example` (used by `just bootstrap` for local
# dev) with production-only defaults: TETHER_SECURE_COOKIES=true and an absolute
# TETHER_PI_AGENT_DIR outside any git worktree. `TETHER_DATABASE_PATH`,
# `TETHER_KB_ROOT`, and `FASTEMBED_CACHE_PATH` are NOT set here — compose.yaml
# pins those to the `data`/`model-cache` volumes for every environment.

# --- Image tag (optional) ----------------------------------------------------
# Which published GHCR tag `docker compose up` runs. `just deploy` (from your
# laptop) pushes `:<git-sha>` and moves `:latest` to it. Pin to a sha to roll
# back (docs/deployment.md#rollback); unset/latest tracks the newest push.
# TETHER_IMAGE_TAG=latest

# --- Auth (required) --------------------------------------------------------
# App login password, session-cookie signing secret, and static bearer token for
# phone/watch capture clients. Generate each independently, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
TETHER_APP_PASSWORD=change-me
TETHER_SESSION_SECRET=change-me
TETHER_API_TOKEN=change-me

# --- Speech-to-text (required) -----------------------------------------------
# STT is an always-on host dependency (ADR 0018): the host fails fast at boot
# if this is unset. Points at any OpenAI-compatible transcription endpoint
# (OpenAI, Groq, a self-hosted server) by base URL.
TETHER_STT_API_KEY=change-me
# TETHER_STT_BASE_URL=https://api.openai.com/v1
# TETHER_STT_MODEL=whisper-1

# --- Text-to-speech (required) -----------------------------------------------
# Conversation mode generates consistent audio through an OpenAI-compatible
# speech endpoint. Keep this credential separate because STT may use another
# provider.
TETHER_TTS_API_KEY=change-me
# TETHER_TTS_BASE_URL=https://api.openai.com/v1
# TETHER_TTS_MODEL=gpt-4o-mini-tts
# TETHER_TTS_VOICE=alloy

# --- Cookies ----------------------------------------------------------------
# Secure cookies require HTTPS. Public Tailscale Funnel terminates HTTPS on the
# VM, so this MUST be true here (unlike the local repo-root `.env.example`,
# which defaults it false for plain http://localhost).
TETHER_SECURE_COOKIES=true

# --- Agent model (required for chat / scheduled-prompt triggers) ------------
# The default model id and the allowlist the UI offers. The allowlist is JSON;
# `id` is selected by `TETHER_DEFAULT_MODEL`. Provider credentials do not live
# in this file; pi reads them from ${TETHER_PI_AGENT_DIR}/auth.json (see below —
# authorize it once, from a laptop, over `ssh -L` or by copying the file).
# The allowlist MUST stay single-quoted: dotenv-style parsers strip embedded
# double quotes from an unquoted value, which would corrupt the JSON.
TETHER_DEFAULT_MODEL=gpt-5.6-luna
TETHER_MODEL_ALLOWLIST='[{"display_name":"GPT-5.6 Luna · no thinking","id":"gpt-5.6-luna","model_id":"gpt-5.6-luna","provider":"openai-codex","thinking_level":"off"},{"display_name":"GPT-5.6 Luna · low thinking","id":"gpt-5.6-luna-low","model_id":"gpt-5.6-luna","provider":"openai-codex","thinking_level":"low"},{"display_name":"GPT-5.6 Terra · low thinking","id":"gpt-5.6-terra-low","model_id":"gpt-5.6-terra","provider":"openai-codex","thinking_level":"low"},{"display_name":"GPT-5.6 Terra · medium thinking","id":"gpt-5.6-terra","model_id":"gpt-5.6-terra","provider":"openai-codex","thinking_level":"medium"},{"display_name":"GPT-5.6 Sol · medium thinking","id":"gpt-5.6-sol","model_id":"gpt-5.6-sol","provider":"openai-codex","thinking_level":"medium"}]'

# --- pi provider credentials -------------------------------------------------
# Mounted into the container as /pi-agent and used as PI_CODING_AGENT_DIR. This
# is durable secret state (Codex OAuth tokens, OpenCode Go API key). Point it at
# a directory under the app dir and authorize it once. This directory is
# durable across deploys but is NOT currently included by deploy/backup.sh;
# provider reauthorization or a separately secured copy is the recovery path:
#   mkdir -p /srv/tether/pi-agent && chmod 700 /srv/tether/pi-agent
#   PI_CODING_AGENT_DIR=/srv/tether/pi-agent /srv/tether/apps/agent/node_modules/.bin/pi
#   /login openai-codex
# The container runs as root, so refreshed OAuth files may become root-owned.
TETHER_PI_AGENT_DIR=/srv/tether/pi-agent

# --- Web search (optional) ---------------------------------------------------
# Tavily-backed agent search defaults on but remains unavailable without a key.
# The monthly credit cap persists across restarts; advanced searches cost two.
# TETHER_SEARCH_ENABLED=true
# TETHER_SEARCH_API_KEY=
# TETHER_SEARCH_MAX_USES=1000
# TETHER_SEARCH_MIN_REQUEST_INTERVAL_SECONDS=1.0

# --- Gmail tooling and ingestion (optional) -------------------------------
# With a token, `search_gmail` + `read_gmail_message` are always available from
# agents and chat. They only require gmail.readonly and never mutate mailbox state.
# Turn on background triage with `TETHER_GMAIL_SYNC_ENABLED=true` only when
# you want proposals to auto-generate from incoming mail.
#
# TETHER_GMAIL_CLIENT_SECRET_PATH=/data/gmail/client-secret.json
# TETHER_GMAIL_TOKEN_PATH=/data/gmail/token.json
# TETHER_GMAIL_OAUTH_NO_BROWSER=false
# TETHER_GMAIL_SYNC_ENABLED=false
# TETHER_GMAIL_SYNC_INTERVAL_SECONDS=900
# TETHER_GMAIL_TRIAGE_BATCH_SIZE=10

# --- Optional ingestion gates (YouTube / Readwise / kosync) ------------------
# All off by default and safe to leave unset. Copy the relevant block from the
# repo-root `.env.example` if/when you turn one on in production; see
# docs/deployment.md and docs/development.md for the setup steps.
