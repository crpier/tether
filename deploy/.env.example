# Production `.env` template for the VM deploy (docs/deployment.md).
#
# Copy to `/srv/tether/.env` (next to `compose.yaml`) and fill in real values —
# assembled by hand from 1Password (source of truth), never committed.
# `deploy/restic.env.example` is separate: it's read by the backup timer, not by
# the app container.
#
# Database paths are fixed by Compose inside the host's `data` volume.

# --- Image tag (optional) ----------------------------------------------------
# Which published GHCR tag `docker compose up` runs. `just deploy` (from your
# laptop) pushes `:<git-sha>` and moves `:latest` to it. Pin to a sha to roll
# back between post-migration host images. A full migration rollback also checks
# out the recorded pre-migration Compose revision; see docs/deployment.md.
# TETHER_IMAGE_TAG=latest

# --- Auth (required) --------------------------------------------------------
# Generate each independently, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Android Health Connect bearer token for the unchanged host origin on HTTPS 443.
TETHER_API_TOKEN=change-me
# Dedicated server-side bearer token for Open WebUI's Tether tool connection.
# Never reuse the Capture token or expose this value to browser requests.
TETHER_OPEN_WEBUI_TOKEN=change-me
# Open WebUI's own session-signing secret.
WEBUI_SECRET_KEY=change-me

# --- Origins ----------------------------------------------------------------
# Open WebUI is exposed through a second Tailscale Funnel listener on HTTPS 8443.
WEBUI_URL=https://tether.example.ts.net:8443
